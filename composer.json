{
  "name": "wordpress-next/core",
  "description": "WordPress Next development quality gates",
  "type": "project",
  "require": {
    "ext-dom": "*",
    "ext-exif": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-libxml": "*",
    "ext-pdo_sqlite": "*",
    "ext-tokenizer": "*",
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "format:check": "phpcs -q",
    "format:fix": "phpcbf",
    "check": [
      "@lint",
      "@analyse",
      "@format:check",
      "@test"
    ],
    "test": [
      "@php tests/smoke.php",
      "@php tests/hardening.php",
      "@php tests/assets.php"
    ],
    "lint": "@php tools/lint.php",
    "test:http": "python3 tests/http-smoke.py",
    "test:permalinks": "python3 tests/permalinks-http.py",
    "test:profiles": "python3 tests/profiles-taxonomy-http.py",
    "test:assets": [
      "python3 tests/assets-integration.py",
      "python3 tests/assets-http.py"
    ],
    "test:design": "python3 tests/design-files-http.py",
    "test:documents": "python3 tests/documents-http.py",
    "test:images": "python3 tests/images-http.py",
        "test:accounts": "python3 tests/accounts-http.py"
  }
}
