# Secondary safeguard only. Install the complete vhost rules from docs/INSTALL.md.
# DirectoryMatch belongs in server/vhost configuration, never in .htaccess.
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:var|docs|vendor|tests|tools|bin|wp-includes)(?:/|$) - [F,L,NC]

RewriteRule ^wp-content/.*\.(?:php|phtml|phar)(?:/|$) - [F,L,NC]
RewriteRule ^wp-admin/.*\.php/ - [R=404,L,NC]
RewriteRule ^(?:wp-config|wp-cron)\.php(?:/|$) - [R=404,L,NC]

<FilesMatch "(?i)\.(sqlite|sqlite-wal|sqlite-shm|db|key|lock|log|md|env.*)$|^(composer\.(json|lock)|package(-lock)?\.json|phpstan\.neon|phpcs\.xml)$">
	Require all denied
</FilesMatch>

# Route non-file public paths through the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L,QSA]
